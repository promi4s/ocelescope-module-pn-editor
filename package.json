{
	"name": "ocelescope-instance",
	"version": "0.10.3",
	"private": true,
	"packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
	"scripts": {
		"add:module": "node scripts/add-module.mjs module",
		"add:backend": "node scripts/add-module.mjs backend",
		"add:frontend": "node scripts/add-module.mjs frontend",
		"sync": "pnpm run sync:backend && pnpm run sync:frontend",
		"sync:backend": "uv sync",
		"sync:frontend": "pnpm install && pnpm run build:modules",
		"build:modules": "pnpm -r --filter \"!@instance/app\" run build",
		"dev": "pnpm run dev:backend & pnpm run dev:app",
		"dev:backend": "uv run ocelescope-backend serve --reload --reload-dir backend-modules --env-file .env",
		"dev:app": "pnpm --filter @instance/app dev",
		"dev:modules": "pnpm -r --parallel --filter \"!@instance/app\" run dev",
		"docker": "docker compose up --build",
		"docker:down": "docker compose down",
		"format": "biome format --write . && uv run ruff format",
		"format:check": "biome format . && uv run ruff format --check",
		"typecheck:backend": "uv run ty check"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15"
	}
}
